{
  "name": "islamic-life-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "set PORT=3000 && set BROWSER=none && react-scripts start",
    "build": "react-scripts build",
    "check": "eslint --no-eslintrc -c eslint.check.json --quiet --ext .js,.jsx src",
    "i18n": "python3 scripts/i18n-missing.py ar && python3 scripts/i18n-missing.py en",
    "packs": "python3 scripts/build-packs.py",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "date-fns": "^3.0.0",
    "expo": "54.0.33",
    "firebase": "^12.15.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.294.0",
    "postcss": "^8.4.31",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.5.0",
    "sonner": "^1.2.0",
    "tailwindcss": "^3.3.0"
  },
  "proxy": "http://localhost:8001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
