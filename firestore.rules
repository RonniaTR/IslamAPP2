rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Public / Read-Only Collections for Content
    match /categories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /articles/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /series/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /audio/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /discover/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /hadiths/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Önceden herkese açık yazılabiliyordu (if true): giriş yapmamış biri bütün odaları silebilir ya da
    // bozabilirdi. Okuma açık (bekleme odası listesi), yazma yalnız giriş yapmış kullanıcıya.
    // NOT: Misafir kullanıcılar Firebase'de oturum açmadığı için oda kuramaz/katılamaz. Misafire de açmak
    // için Firebase Anonymous Auth gerekir (Antigravity: konsolda etkinleştir + loginAsGuest'e ekle).
    match /quiz_rooms/{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    // User-Specific Collections
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /history/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /bookmarks/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /recommendations/{userId} {
      allow read: if isOwner(userId) || userId == 'anonymous';
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /goals/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Legacy Collections
    match /Users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /UserProgress/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Kandil ışık haritası: il başına ANONİM sayaç. Yalnız `n` alanı, yalnız +1. Silme ve başka alan yok.
    // Kötüye kullanım için App Check açılmalıdır (docs/YENI_OZELLIKLER.md 8.7).
    match /kandil/{gece}/iller/{il} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // ODA (ekran paylaşımı / birlikte izleme). Belge yalnız tanışma bilgisini (teklif/cevap) ve odanın kendi
    // adlarını/şiirlerini tutar; görüntü, ses ve sohbet hiçbir yere yazılmaz. En çok iki üye.
    match /odalar/{oda} {
      allow create: if request.auth != null && request.resource.data.sahip == request.auth.uid
        && request.resource.data.uyeler == [request.auth.uid];
      allow read: if request.auth != null && (request.auth.uid in resource.data.uyeler || resource.data.uyeler.size() < 2);
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.uyeler && request.resource.data.uyeler == resource.data.uyeler
          && request.resource.data.sahip == resource.data.sahip)
        || (request.auth.uid == resource.data.sahip && request.resource.data.sahip == resource.data.sahip)
        || (resource.data.uyeler.size() < 2 && !(request.auth.uid in resource.data.uyeler)
          && request.resource.data.uyeler == resource.data.uyeler.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uyeler', 'isimler']))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.sahip;
      match /aday/{a} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/odalar/$(oda)).data.uyeler;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}