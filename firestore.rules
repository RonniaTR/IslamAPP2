rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Public / Read-Only Collections for Content
    match /categories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /articles/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /series/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /audio/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /discover/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /hadiths/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Önceden herkese açık yazılabiliyordu (if true): giriş yapmamış biri bütün odaları silebilir ya da
    // bozabilirdi. Okuma açık (bekleme odası listesi), yazma yalnız giriş yapmış kullanıcıya.
    // NOT: Misafir kullanıcılar Firebase'de oturum açmadığı için oda kuramaz/katılamaz. Misafire de açmak
    // için Firebase Anonymous Auth gerekir (Antigravity: konsolda etkinleştir + loginAsGuest'e ekle).
    match /quiz_rooms/{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    // User-Specific Collections
    // Hesap silme (Apple 5.1.1(v), Google Play): sahibi kendi belgesini silebilir.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /history/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /bookmarks/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /recommendations/{userId} {
      allow read: if isOwner(userId) || userId == 'anonymous';
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /goals/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Legacy Collections
    match /Users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /UserProgress/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Kandil ışık haritası: il başına ANONİM sayaç. Yalnız `n` alanı, yalnız +1. Silme ve başka alan yok.
    // Kötüye kullanım için App Check açılmalıdır (docs/YENI_OZELLIKLER.md 8.7).
    match /kandil/{gece}/iller/{il} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // Ortak salavat (services/salavat.js): gün başına 10 parçalı ANONİM sayaç. Yalnız `n` alanı; her yazma 1–100 artış.
    // Kimlik, konum, saat yok. Kötüye kullanım için App Check açılmalıdır.
    match /salavat/{gun}/parca/{parca} {
      allow read: if true;
      allow create: if parca.matches('p[0-9]') && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 100;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 100;
      allow delete: if false;
    }

    // Yapay zekâ cevabı bildirimi (services/aiReports.js): kimliksiz, yalnız oluşturma; okuma ve silme kapalı.
    // Alanlar ve boyutlar sınırlı; konsoldan (yönetici erişimi) okunur.
    match /ai_reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['q', 'a', 'reason', 'platform', 'at'])
        && request.resource.data.q is string && request.resource.data.q.size() <= 1000
        && request.resource.data.a is string && request.resource.data.a.size() <= 4000
        && request.resource.data.reason in ['yanlis', 'uygunsuz', 'kaynak', 'diger']
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 12
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}