# android/keystore.properties.example
# ─────────────────────────────────────────────────────────────
# Bu dosyayı "keystore.properties" adıyla kopyalayıp doldurun.
# GERÇEK dosya .gitignore'dadır ve ASLA depoya eklenmemelidir.
#
# Keystore oluşturma (bir kez, ve YEDEĞİNİ SAKLAYIN — kaybederseniz
# aynı uygulamayı bir daha güncelleyemezsiniz):
#
#   keytool -genkey -v -keystore islamapp-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias islamapp
#
# ─────────────────────────────────────────────────────────────

storeFile=islamapp-release.jks
storePassword=BURAYA_STORE_SIFRESI
keyAlias=islamapp
keyPassword=BURAYA_KEY_SIFRESI
